import os
import requests
from telegram import Update
from telegram.ext import ApplicationBuilder, ContextTypes, MessageHandler, filters

TOKEN = os.getenv("8932287210:AAE8wsNh_obNakfPTJhWMErJa0oMCJ_P5N8")

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    url = update.message.text.strip()
    
    if url.startswith("http://") or url.startswith("https://"):
        await update.message.reply_text("⏳ লিংক থেকে এইচটিএমএল কোড আনা হচ্ছে, একটু অপেক্ষা করুন...")
        try:
            response = requests.get(url, timeout=10)
            html_code = response.text
            
            if len(html_code) > 4000:
                file_path = "source_code.html"
                with open(file_path, "w", encoding="utf-8") as f:
                    f.write(html_code)
                
                await update.message.reply_document(
                    document=open(file_path, "rb"),
                    caption=f"✅ এর জন্য এইচটিএমএল কোড ফাইল: {url}"
                )
                os.remove(file_path)
            else:
                await update.message.reply_text(f"```html\n{html_code}\n```", parse_mode="Markdown")
                
        except Exception as e:
            await update.message.reply_text(f"❌ কোড আনতে সমস্যা হয়েছে: {str(e)}")
    else:
        await update.message.reply_text("⚠️ দয়া করে একটি সঠিক লিংক দিন (যেমন: https://example.com)।")

def main():
    if not TOKEN:
        print("ত্রুটি: বটের টোকেন সেট করা নেই!")
        return

    application = ApplicationBuilder().token(TOKEN).build()
    application.add_handler(MessageHandler(filters.TEXT & (~filters.COMMAND), handle_message))
    
    print("বট চালু হচ্ছে...")
    application.run_polling()

if __name__ == "__main__":
    main()